#!/bin/bash

function g_next() {
	CURR_COMMIT=$(git rev-parse HEAD)
	git checkout $(git log --branches -1 --pretty=format:"%H")
	NEXT_COMMIT=$(git rev-list "$CURR_COMMIT"..HEAD | tail -1)
	git checkout "$NEXT_COMMIT"
}

function g_prev() {
	git checkout HEAD^1
}

function gwtcd() {
  cd "$(gwtls | fzf | awk '{print $1}')"
}

function create_gitlab_mr() {
    if [ -z "$GITLAB_USER_ID" ]; then
        echo "Error: GITLAB_USER_ID environment variable is not set."
        return 1
    fi
    glab mr create -a "$GITLAB_USER_ID" --fill --remove-source-branch --draft
}

function awsp() {
  local profile
  profile=$(aws configure list-profiles | fzf --height 30% --reverse --prompt="AWS Profile > ")

  if [ -n "$profile" ]; then
    export AWS_PROFILE="$profile"
    echo "Switched to AWS_PROFILE=$AWS_PROFILE"
  fi
}
