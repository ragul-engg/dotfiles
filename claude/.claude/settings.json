{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git blame:*)",
      "Bash(git reflog:*)",
      "Bash(git describe:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git shortlog:*)",
      "Bash(git name-rev:*)",
      "Bash(git merge-base:*)",
      "Bash(git cat-file:*)",
      "Bash(git whatchanged:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git stash list:*)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/config)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install *)",
      "Bash(curl:*)"
    ]
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "thinking"
    ]
  },
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "opus",
  "tui": "fullscreen",
  "theme": "dark"
}

